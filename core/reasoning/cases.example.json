    {
      "id": "missing_dependency",
      "category": "troubleshooting",
      "question": "In this simulated traceback: ModuleNotFoundError: No module named 'pygame'. Which Python package is missing? Give only its name.",
      "now": "2026-10-13T19:25:00-07:00",
      "timezone": "America/Los_Angeles",
      "evidence": {
        "traceback": "ModuleNotFoundError: No module named 'pygame'"
